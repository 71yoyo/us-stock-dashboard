# 이 파일은 값의 형식만 보여 주는 예시입니다. 실제 API 키는 .env에만 입력합니다.
# .env는 .gitignore로 보호되며 GitHub에 올라가지 않습니다.

# Cloudflare Worker에서 사용할 금융 데이터 API의 키입니다.
# 실제 배포에서는 이 파일이 아니라 Cloudflare Workers의 Secret으로 등록합니다.
MARKET_DATA_API_KEY=your_api_key_here

# 사용할 금융 API 공급자를 확정한 후 입력합니다.
MARKET_DATA_PROVIDER=provider_name

# Pages와 Worker가 다른 도메인일 때 허용할 Pages 주소입니다.
ALLOWED_ORIGIN=https://your-pages-project.pages.dev
