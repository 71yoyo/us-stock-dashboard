{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "us-stock-dashboard-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "vars": {
    "DIVIDEND_PIPELINE_ENABLED": "true",
    "BUSINESS_QUANT_DAILY_FETCH_LIMIT": "24"
  },
  "triggers": {
    "crons": ["*/5 13-20 * * 1-5", "20 21 * * 1-5", "*/5 21-23 * * 1-5", "*/5 0-6 * * 2-6", "1-59/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "us-stock-pro",
      "database_id": "698ab9b8-4573-40c7-b119-d7b1d681abc8",
      "migrations_dir": "migrations"
    }
  ]
}
